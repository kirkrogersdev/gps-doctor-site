# ---- Public (bundled into the browser build; prefix VITE_) ----
# Stripe hosted payment link / customer portal. Leave empty until Stripe approves the account;
# the Pay Bill page shows a "call to pay" state until this is set.
VITE_STRIPE_PAYMENT_URL=
# Where "Billing support" should go. Defaults to the Contact page's billing section when empty.
VITE_BILLING_SUPPORT_URL=

# ---- Server only (Vercel serverless function api/ccm-contact.ts) ----
# Option A: forward CCM contact requests straight into the SparroWell consent console.
# POSTs JSON { name, phone, email, preferredContact, message, source, submittedAt } with
# header "Authorization: Bearer $SPARROWELL_INTAKE_TOKEN".
SPARROWELL_INTAKE_URL=
SPARROWELL_INTAKE_TOKEN=
# Option B (and/or fallback): email the CCM team via Resend (https://resend.com).
RESEND_API_KEY=
CCM_TEAM_EMAIL=
CCM_FROM_EMAIL=GPS Website <no-reply@gps.doctor>
